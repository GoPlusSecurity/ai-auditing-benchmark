  "slice_reasons": {
    "sandbox-oft": {
      "OFTSand.sol": "证明代币与OApp组合、正常烧币和信用入账铸币，并给出实际_msgSender转接。",
      "SandBaseToken.sol": "证明公开代调用扩展确实被继承到受害地址。",
      "ERC20BasicApproveExtension.sol": "完整保留approveAndCall和paidCall的调用者可控target/data与外呼。",
      "BytesUtil.sol": "完整保留68字节最小长度及首参数相等检查。",
      "ERC2771Handler.sol": "证明普通直接调用者的_msgSender为其自身，不要求转发权限。",
      "OAppCore.sol": "绑定Endpoint、peer和本地onlyOwner的delegate入口。",
      "OAppReceiver.sol": "保留Endpoint来源与peer检查，避免误写为直接任意调用lzReceive。",
      "OApp.sol": "证明OFTCore继承的收发路径确为该OAppCore/OAppReceiver实现。",
      "OFTCore.sol": "证明消息接收、金额单位换算和信用入口，以及正常返程先debit后发消息。",
      "OFTMsgCodec.sol": "证明消息前32字节接收者和随后8字节共享精度金额的实际解码。",
      "ERC20BaseToken.sol": "完整保留无余额要求的授权更新、实际铸币和实际烧币的状态变更。"
    },
    "layerzero-endpoint": {
      "EndpointV2.sol": "证明delegate以应用自身msg.sender为索引、delegate可配置、有效消息的检查和交付。",
      "MessageLibManager.sol": "保留注册库要求、接收库验证和经授权的配置转发；权限接管不等于任意注册恶意库。",
      "MessagingChannel.sol": "证明已验证payload写入与执行时nonce/hash检查，不把配置劫持误写成关闭全部验证。"
    },
    "layerzero-receive-library": {
      "ReceiveUln302.sol": "证明只有Endpoint可写配置、DVN verify入口和commit把已验证payload交给Endpoint。",
      "UlnBase.sol": "保留配置结构、0值继承默认语义、至少一个验证者及数组有效性检查，证明修改required DVN不是关闭所有检查。",
      "ReceiveUlnBase.sol": "保留msg.sender验证记录及required/optional与确认数检查的完整实际实现。",
      "MessageLibBase.sol": "保留onlyEndpoint和绑定端点的实现。",
      "ReceiveLibBaseE2.sol": "证明该库绑定本地Endpoint和接收库角色。"
    },
    "sandbox-ethereum-adapter": {
      "OFTAdapterForSand.sol": "证明以太坊的实际部署类型、底层token构造绑定和发送开关。",
      "OFTAdapter.sol": "完整保留锁定底层已有代币与安全转账支付储备的两条资金路径。",
      "OFTCore.sol": "证明以太坊也按消息amount调用adapter._credit。",
      "OAppReceiver.sol": "保留以太坊接收的Endpoint和peer检查，不能把源链受损描述为主网验签被攻破。",
      "SafeERC20.sol": "证明_credit实际调用ERC20 transfer并检查返回值。"
    },
    "sandbox-ethereum-sand": {
      "Sand.sol": "绑定底层SAND原始代币继承和初始化发行。",
      "ERC20BaseToken.sol": "保留18位精度、transfer/transferFrom与已有余额扣减，说明主网付款不是凭空增发。"
    }
  },
  "metadata": {
    "project_cn": "The Sandbox（SAND OFT 跨链桥）",
    "project_en": "The Sandbox (SAND OFT bridge)",
    "vulnerability_cn": "公开任意外部调用导致 LayerZero delegate 被接管",
    "vulnerability_en": "Arbitrary external call enables LayerZero delegate takeover",
    "detail_cn": "OFTSand继承的approveAndCall/paidCall只检查首参数和长度，却允许普通调用者让代币合约以自身身份调用任意目标。攻击者用68字节setDelegate数据绕过本地onlyOwner入口，把自己设为应用delegate，再修改已注册ReceiveUln302的required DVN为自己，自行verify并commit伪造消息。历史交易证实首铸5000万SAND，首笔出售1496724.864727844728117234 SAND得到14.64553552927302136 WETH。源表约67万美元与官方后续约69.7万美元未能统一，CSV损失字段留空；两种估计及跨链赎回总额仅作背景，不是本批独立汇总。",
    "detail_en": "OFTSand inherited public approveAndCall/paidCall helpers that checked only payload length and the first argument while allowing arbitrary external calls from the token identity. A 68-byte setDelegate payload let an ordinary caller bypass the local owner-only setter, become the application delegate, change the existing ReceiveUln302 required DVN to itself, submit verification, and commit a fabricated message. Archived transactions verify the first mint of 50,000,000 SAND and the first sale of 1,496,724.864727844728117234 SAND for 14.64553552927302136 WETH. The source-sheet estimate of $670,000 and the later official ~$697,000 remain unreconciled, so both CSV loss fields are blank. These estimates and the aggregate cross-chain redemption amount were not independently summed in this batch.",
    "loss_usd": null,
    "loss_cn": "",
    "loss_en": "",
    "loss_scope": "Unresolved discrepancy: source sheet estimates USD 670000 while the later official disclosure estimates approximately USD 697000. No unified incident total was independently established; both CN and EN CSV loss fields must remain blank.",
    "event_date": "2026-08-22",
